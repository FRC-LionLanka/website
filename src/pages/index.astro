---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";

import teamLogoOutline from "../assets/logo-outlined.png";

import heroBackground from "../assets/hero-background.jpeg";
const processedHeroBackground = await getImage({
    src: heroBackground,
    format: "webp",
});

import whatIsFrcCover from "../assets/whatisfrc-cover-image.png";

import Timeline from "../components/timeline.astro";
import TimelineItem from "../components/timeline-item.astro";

import { YouTube } from "astro-embed";
---

<BaseLayout>
    <section
        id="hero"
        class="hero-layout"
        style={`--hero-bg: url(${processedHeroBackground.src});`}
    >
        <div class="hero-inner">
            <div class="hero-content two-col">
                <div id="hero-text">
                    <h1>Lion Lanka</h1>
                    <h2 class="muted">FRC #12560</h2>
                    <p>
                        Sri Lanka’s founding FIRST Robotics Competition team.
                        High school students competing on the global stage.
                    </p>
                </div>
                <Image src={teamLogoOutline} alt="Team logo" height="400" />
            </div>

            <div class="button-group">
                <a href="/join" class="button-link">
                    Join the Team
                </a>
                <a href="/sponsors" class="button-link secondary-button">
                    Sponsor our Goal
                </a>
            </div>
        </div>
    </section>

    <section id="what-is-frc">
        <h1>What is FRC?</h1>
        <div class="two-col">
            <div>
                <ul>
                    <li>
                        FRC is the pinnacle of youth robotics. Where hands-on
                        engineering meets varsity sports intensity.
                    </li>
                    <li>
                        Each year between January and March, students design,
                        build, and program a 50-kilogram robot to compete
                        against others in international events.
                    </li>
                    <li>
                        By doing so, students gain hands-on experience in
                        engineering, programming, and teamwork. Vital to thrive
                        in the modern-day world!
                    </li>
                </ul>
                <br />
                <a href="/what-is-frc">Still curious? Check it out further!</a>
            </div>
            <div class="subtitled-container">
                <YouTube
                    id="Jd29kzjclV0"
                    poster={whatIsFrcCover.src}
                    class="content-container"
                />
                <p class="caption">FIRST: Official Explainer Video</p>
            </div>
        </div>
    </section>

    <section id="who-are-we">
        <h1>Who are we?</h1>
        <div class="two-col">
            <div>
                <ul>
                    <li>
                        We're the first (and only!) FRC team in Sri Lanka: Lion
                        Lanka. Pioneering a new path for engineering-keen youth.
                    </li>
                    <li>
                        Preparing for the 2027 Biocore season, we're looking for
                        interested students, mentors, and sponsors to support
                        our mission.
                    </li>
                </ul>
                <br />
                <a href="/info">
                    Learn more about us, and how to join the team
                </a>
            </div>

            <Timeline>
                <TimelineItem date="Now" title="Recruitment" active>
                    Recruiting students, mentors, and sponsors across Colombo.
                </TimelineItem>

                <TimelineItem
                    date="9th Jan 2027"
                    title="BIOCORE Kickoff & Build Season"
                >
                    Global game reveal followed by an 8-week sprint to design,
                    build, and program our robot for competition.
                </TimelineItem>

                <TimelineItem
                    date="12-14th March 2027"
                    title="Southern Cross Regional — Sydney"
                >
                    Travelling to Sydney and putting our season's work to the
                    test, representing Sri Lanka on the global stage.
                </TimelineItem>
            </Timeline>
        </div>
    </section>
</BaseLayout>

<style>
    #hero {
        width: 100vw;
        margin-top: -2rem;

        background-image:
            linear-gradient(rgba(20, 20, 20, 0.55), rgba(20, 20, 20, 0.75)),
            var(--hero-bg);
        background-size: cover;
        background-position: center bottom;
        background-repeat: no-repeat;
        background-attachment: fixed;

        padding-top: 3rem;
        padding-bottom: 6vw;
        clip-path: polygon(0 0, 100% 0, 100% calc(100% - 4vw), 0 100%);
    }

    .hero-content > img {
        justify-self: end;
    }

    /* Dark overlay for text contrast */
    .hero-bg::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
            rgba(20, 20, 20, 0.55),
            rgba(20, 20, 20, 0.75)
        );
    }

    .hero-bg-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
        max-width: calc(1230px + 2rem);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        padding: 0 2rem;
        gap: 2rem;
    }

    #hero-text {
        margin: auto 0;
        font-size: 1.3rem;
    }

    #hero-text h1 {
        font-size: 4rem;
    }

    #hero-text h2 {
        margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
        .hero-inner {
            padding: 0 1.75rem;
        }

        .hero-content > img {
            order: -1; /* Puts the lion logo above the text on mobile */
            justify-self: center;
            max-width: 220px;
            height: auto;
        }

        #hero-text {
            text-align: center; /* Optional: looks cleaner centered under the logo */
        }
    }
</style>
