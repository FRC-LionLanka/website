---
import Navbar from "../components/navbar.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css"
        />

        <title>FRC LionLanka</title>
    </head>
    <body>
        <header>
            <Navbar />
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div id="footer-content">
                <p>Lion Lanka</p>
                <div id="footer-socials">
                    <a
                        href="https://www.instagram.com/frc_lionlanka/"
                        class="lab la-instagram"
                    ></a>
                    <a href="mailto:enquiries@lionlanka.lk">
                        enquries@lionlanka.lk <i class="las la-share"></i>
                    </a>
                </div>
            </div>
        </footer>
    </body>
</html>

<style>
    #footer-content {
        display: flex;
        flex-direction: row;
        max-width: 1250px;
        margin: 0 auto;
        justify-content: space-between;
    }

    #footer-socials {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: center;
    }

    #footer-socials a {
        text-decoration: none;
    }
</style>
<style is:global>
    :root {
        --carbon: #141414;
        --soot: #242424;
        --cinnabar: #ab312d;
        --cinnabar-hover: #cf3d38;
        --white: #f8f9fa;
        --text-muted: #a0a09f;
        --cornflower: #3a6ea5;
        --steelazure: #004e98;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        font-size: 21px;
    }

    main {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 3.5rem;
    }

    body {
        background: var(--carbon);
        color: var(--white);
        font-family: "Montserrat", sans-serif;
    }

    section {
        display: flex;
        flex-direction: column;
        row-gap: 1rem;
        padding-bottom: 2rem;
        border-bottom: 2px solid var(--soot);
    }

    section:last-of-type {
        padding: 0;
        border-bottom: none;
    }

    h1,
    h2,
    h3 {
        font-family: "Space Grotesk", sans-serif;
    }

    h1 {
        font-size: 2.6rem;
        margin-bottom: 0.2rem;
    }

    ul {
        list-style-type: square;
        padding-left: 1rem;
    }

    li {
        margin-bottom: 0.6rem;
    }
    a {
        text-decoration: underline dashed var(--text-muted) 0.5px;
        color: var(--text-muted);
    }

    a:hover {
        color: var(--cinnabar-hover);
        text-decoration-color: var.site-header (--cinnabar-hover);
        cursor: pointer;
    }

    header {
        background-color: var(--soot);
        padding: 0.5rem 1.5rem;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    footer {
        text-align: center;
        padding: 1rem;
        background: var(--soot);
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 5%;
    }

    .button-group {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: stretch;
    }

    .button-link {
        padding: 0.75rem 1.5rem;
        background-color: var(--cinnabar);
        color: var(--white);
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
        display: inline-block;
        transition: background-color 0.2s ease;
        text-align: center;
        flex-grow: 1;
    }

    .button-link:hover {
        background-color: var(--cinnabar-hover);
        border-color: var(--cinnabar-hover);
        color: var(--white);
    }

    .muted {
        color: var(--text-muted);
    }

    .content-container {
        border: 4px solid var(--steelazure);
        border-radius: 5px;
    }

    .content-container > iframe {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
    }

    .subtitled-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.5rem;
    }

    .subtitled-container p {
        color: var(--text-muted);
        text-align: center;
    }
</style>
