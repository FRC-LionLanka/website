---
import Navbar from "../components/navbar.astro";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://maxst.icons8.com/vue-static/landings/line-awesome/line-awesome/1.3.0/css/line-awesome.min.css"
        />

        <title>FRC LionLanka</title>
    </head>
    <body>
        <header>
            <Navbar />
        </header>

        <main>
            <slot />
        </main>
        <footer></footer>
    </body>
</html>

<style is:global>
    :root {
        --carbon: #141414;
        --card-bg: #242424;
        --cinnabar: #ab312d;
        --cinnabar-hover: #cf3d38;
        --white: #f8f9fa;
        --text-muted: #a0a09f;
        --cornflower: #3a6ea5;
        --steelazure: #004e98;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--carbon);
        color: var(--white);
        font-family: "Montserrat", sans-serif;
        line-height: 1.6;
    }

    h1,
    h2,
    h3 {
        font-family: "Space Grotesk", sans-serif;
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }

    h1 {
        font-size: clamp(2rem, 4vw, 3.5rem);
    }

    main {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 5rem;
    }

    ul {
        list-style-type: square;
    }

    a {
        text-decoration: underline dashed var(--text-muted) 0.5px;
        color: var(--text-muted);
    }

    a:hover {
        color: var(--cinnabar-hover);
        text-decoration-color: var.site-header (--cinnabar-hover);
    }

    header {
        background-color: var(--card-bg);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.5rem 1.5rem;
    }

    footer {
        text-align: center;
        padding: 1rem;
        background: var(--card-bg);
        color: var(--text-muted);
        font-size: 0.9rem;
    }
</style>
