    <div class="logo">
        <a href="/">Lion Lanka</a>

        <button id="mobile-navbar-toggle" class="hamburger-btn"
            ><i class="las la-bars"></i>
        </button>
    </div>
    <ul class="nav-links">
        <li><a href="/what-is-frc">What is FRC?</a></li>
        <li><a href="/sponsors">Sponsor Us</a></li>
        <li><a href="/join">Join the Team</a></li>
        <li><a href="/info">About Us</a></li>
    </ul>
</nav>

<style>
    .nav-container {
        display: flex;
        max-width: 1250px;
        justify-content: space-between;
        margin: 0 auto;
        align-items: center;
    }

    
    .nav-container a {
        text-decoration: none;
    }

    .hamburger-btn {
        background: transparent;
        border: none;
        display: none;
        font-size: 2rem;
        color: var(--text-muted);
        cursor: pointer;
    }

    .nav-links {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        list-style: none;
    }

    .logo a {
        font-family: 'Space Grotesk';
        font-size: 1.6rem;
    }
    @media (max-width: 768px) {
        .logo {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .hamburger-btn {
            display: flex;
        }
        .nav-container {
            flex-direction: column;
        }

        .nav-links {
            flex-direction: column;
            align-items: center;
            max-height: 0;
            overflow: hidden;
        }

        .nav-links.active {
            max-height: 300px;
            margin-top: 1.3rem;
        }

        .nav-links li {
            width: 100%;
            border-top: 1px solid var(--text-muted);
            text-align: center;
            padding-top: 0.75rem;
        }
    }
</style>

<script>
    function setupMobileMenu() {
        const toggleBtn = document.getElementById("mobile-navbar-toggle");
        const navLinks = document.querySelector(".nav-links");

        if (toggleBtn && navLinks) {
            const newBtn = toggleBtn.cloneNode(true);
            toggleBtn.parentNode.replaceChild(newBtn, toggleBtn);

            newBtn.addEventListener("click", () => {
                navLinks.classList.toggle("active");
            });
        }
    }

    setupMobileMenu();
    document.addEventListener("astro:page-load", setupMobileMenu);
</script>
