---
interface Props {
    date: string;
    title: string;
    active?: boolean;
}

const { date, title, active = false } = Astro.props;
---

<div class:list={["timeline-step", { active }]}>
    <span class="step-dot"></span>
    <div class="step-content">
        <span class="step-date">{date}</span>
        <h3>{title}</h3>
        <div class="step-body">
            <slot />
        </div>
    </div>
</div>

<style>
    .timeline-step {
        position: relative;
    }

    .step-dot {
        position: absolute;
        left: -1.75rem;
        top: 5px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--carbon);
        border: 2px solid var(--cinnabar);
    }

    .timeline-step.active .step-dot {
        background: var(--cinnabar);
        box-shadow: 0 0 0 4px rgba(171, 49, 45, 0.25);
    }

    .step-date {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--cinnabar-hover);
        margin-bottom: 0.2rem;
    }

    .step-content h3 {
        font-size: 1.15rem;
        margin-bottom: 0.25rem;
        color: var(--white);
    }

    .step-body {
        font-size: 0.95rem;
        color: var(--text-muted);
    }

    .step-body :global(p) {
        margin: 0;
    }
</style>
